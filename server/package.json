{
  "name": "@builder/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/server/src/server.js",
    "bootstrap": "tsx --env-file-if-exists=../.env src/scripts/bootstrap.ts",
    "seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@builder/shared": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
