NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for read-only demo mode. Use a dedicated database.
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set VITE_DEMO_MODE=false and API URL when deploying the real backend.
VITE_DEMO_MODE=true
VITE_API_URL=/api/v1
SITE_URL=http://localhost:5173
# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFY_EMAIL=
SMTP_FROM=
# Optional signed image upload adapter (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
